{
  "name": "server",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.0",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun run --hot src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "hono": "^4.10.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@types/bun": "^1.3.3",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "ultracite": "^6.5.1",
    "vitest": "^3.0.5"
  }
}
